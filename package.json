{
  "name": "gnomicon",
  "version": "51.0.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./icons/*": { "types": "./dist/modules/*.d.ts", "import": "./dist/modules/*.js" },
    "./icons.json": "./dist/icons.json",
    "./svg/*": "./dist/svg/*",
    "./dist/*": "./dist/*"
  },
  "description": "Gnome Symbolic Icon for WebApp",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "python scripts/build.py",
    "test": "python -m unittest discover -s tests",
    "docs": "cd docs-src && deno task build",
    "prepack": "python scripts/build.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keenly-coding/gnomicon.git"
  },
  "keywords": [
    "icon",
    "svg"
  ],
  "author": "Nitipit Nontasuwan",
  "license": "SEE LICENSE IN license.md",
  "bugs": {
    "url": "https://github.com/keenly-coding/gnomicon/issues"
  },
  "homepage": "https://keenly-coding.github.io/gnomicon/",
  "files": [
    "dist/**/*",
    "!dist/jsr/**"
  ]
}
